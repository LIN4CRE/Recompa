# ── Recompa configuration ───────────────────────────────────────────────────
# The web app needs NO configuration: it is entirely client-side.
# These variables only affect the optional local processing service and the
# dataset fetch scripts.

# Optional: raises GitHub API rate limits when running `npm run fetch:dat`.
# A plain unauthenticated call is enough for the 9 default DATs.
GITHUB_TOKEN=

# ── Optional processing service (server/processing-service.mjs) ─────────────
# Port to bind. The service refuses non-loopback hosts unless RECOMPA_ALLOW_REMOTE=1.
RECOMPA_SERVICE_PORT=7333
# Hard timeout for each child process, in milliseconds.
RECOMPA_JOB_TIMEOUT_MS=120000
# Comma-separated origins allowed to call the service (the dev server is allowed
# by default). Add your deployed origin if you really intend to use it remotely.
RECOMPA_ALLOWED_ORIGINS=

# Absolute path to a Ghidra install, used for symbol-map extraction jobs.
# Example: /opt/ghidra_11.3_PUBLIC
GHIDRA_HEADLESS=
# Absolute path to a Rizin binary, used for fast structural analysis.
RIZIN_BIN=
# Absolute path to an N64Recomp binary. When set, /jobs/n64recomp-plan emits a
# verified local command line instead of reporting the toolchain as unavailable.
N64RECOMP_BIN=
