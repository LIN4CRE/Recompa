{
  "name": "recompa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first ROM analysis, recompilation and instant-play platform for the browser",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fetch:dat": "node scripts/fetch-dats.mjs",
    "fetch:testroms": "node scripts/fetch-test-roms.mjs",
    "fetch:emulatorjs": "node scripts/fetch-emulatorjs.mjs",
    "serve:processing": "node server/processing-service.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "postinstall": "node scripts/sync-cores.mjs",
    "sync:cores": "node scripts/sync-cores.mjs",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@thenick775/mgba-wasm": "2.6.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "jsnes": "^2.1.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
